{
  "name": "clinic-appointment-system",
  "version": "1.0.0",
  "description": "Backend API for a Clinic Appointment System with JWT authentication",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node src/utils/seedManager.js",
    "seed:demo": "node src/utils/seedDemoData.js",
    "client": "npm --prefix frontend run dev",
    "client:build": "npm --prefix frontend run build"
  },
  "keywords": [
    "clinic",
    "appointment",
    "api",
    "node",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
